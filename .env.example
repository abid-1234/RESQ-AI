# RESQ-AI — Environment variables
# Copy to .env (never commit .env). All values below are optional for demo;
# the app boots in SIMULATION / mock mode when they are absent.

# --- Core ---
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# AI
GEMINI_API_KEY=""

# Database (optional — in-memory mock when absent)
MONGODB_URI="mongodb://localhost:27017/resq-ai"
DATABASE_URL=""

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="24h"

# Alert / broadcast mode
# DEMO | RESEARCH | VALIDATED | LIVE — stamps every prediction with mode + model metadata
AI_MODE="DEMO"
# true = alerts auto-authorize; false (production) = manual authority approval required
AUTOMATIC_MODE="true"

# MQTT ingestion (hierarchy resq/{region}/{hazard}/{sensor_type})
MQTT_BROKER=""
MQTT_PORT="8883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TLS="true"

# Provider adapters (all optional — mock adapters used when absent)
SMS_API_KEY=""
SMS_API_URL=""
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="noreply@resq-ai.local"
PUSH_API_KEY=""
PUSH_API_URL=""
CBC_API_URL=""
CBC_API_KEY=""
CBC_ADAPTER="mock_cbc"
SATELLITE_API_URL=""
SATELLITE_API_KEY=""

# GIS / risk tuning overrides (defaults in config/app.yaml)
# RISK_HAZARD_WEIGHT=0.45
# RISK_VULNERABILITY_WEIGHT=0.35
# RISK_EXPOSURE_WEIGHT=0.20
